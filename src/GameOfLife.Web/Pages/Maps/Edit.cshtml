@page "{code?}"
@model GameOfLife.Web.Pages.Maps.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New Map" : $"Edit: {Model.MapName}";
}

<div class="edit-container">
    <div class="edit-header">
        <h1 class="map-title">@(Model.IsNew ? "NEW MAP" : "EDIT MAP")</h1>
    </div>

    <div class="edit-settings">
        <div class="form-row">
            <label for="mapName">NAME:</label>
            <input type="text" id="mapName" value="@Model.MapName" maxlength="100"
                   placeholder="MY AWESOME MAP" class="arcade-input" />
        </div>
        @if (Model.IsNew)
        {
            <div class="form-row">
                <label for="mapWidth">WIDTH:</label>
                <input type="number" id="mapWidth" value="@Model.MapWidth" min="3" max="200"
                       class="arcade-input small" />
            </div>
            <div class="form-row">
                <label for="mapHeight">HEIGHT:</label>
                <input type="number" id="mapHeight" value="@Model.MapHeight" min="3" max="200"
                       class="arcade-input small" />
            </div>
            <button id="btnApplySize" class="arcade-btn">APPLY SIZE</button>
        }
        else
        {
            <span class="info-badge">@(Model.MapWidth)x@(Model.MapHeight)</span>
        }
    </div>

    <div class="edit-toolbar">
        <button id="btnDraw" class="arcade-btn active" data-tool="draw">DRAW</button>
        <button id="btnErase" class="arcade-btn" data-tool="erase">ERASE</button>
        <button id="btnClear" class="arcade-btn">CLEAR</button>
        <button id="btnRandom" class="arcade-btn">RANDOM</button>
        <button id="btnInvert" class="arcade-btn">INVERT</button>
    </div>

    <div class="edit-area">
        <canvas id="editCanvas"></canvas>
    </div>

    <div class="edit-actions">
        <button id="btnPreview" class="arcade-btn">PREVIEW</button>
        <button id="btnSave" class="arcade-btn primary"
                hx-post="/Maps/Edit"
                hx-trigger="click"
                hx-include="closest .edit-container"
                hx-vals="js:{name: document.getElementById('mapName').value, cellData: window.getEditorCellData(), width: window.getEditorWidth(), height: window.getEditorHeight()}"
                hx-swap="none">
            SAVE
        </button>
    </div>

    <div id="saveResult" class="save-result"></div>

    <div id="previewModal" class="modal hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2>PREVIEW</h2>
                <button id="btnClosePreview" class="arcade-btn small">X</button>
            </div>
            <canvas id="previewCanvas"></canvas>
            <div class="play-controls">
                <button id="btnPreviewPlay" class="arcade-btn primary">PLAY</button>
                <button id="btnPreviewStep" class="arcade-btn">STEP</button>
                <button id="btnPreviewReset" class="arcade-btn">RESET</button>
                <span class="generation-counter">GEN: <span id="previewGenCount">0</span></span>
            </div>
        </div>
    </div>
</div>

<script id="mapData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    isNew = Model.IsNew,
    width = Model.MapWidth,
    height = Model.MapHeight,
    cellData = Model.CellData,
    sourceCode = Model.SourceCode
}))</script>

@section Scripts {
    <script src="~/js/gameoflife.js" asp-append-version="true"></script>
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
