@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1 class="title glitch" data-text="GAME OF LIFE">GAME OF LIFE</h1>
    <p class="subtitle">CONWAY'S CLASSIC CELLULAR AUTOMATON</p>
    <div class="hero-actions">
        <a asp-page="/Maps/Edit" class="arcade-btn primary">CREATE NEW MAP</a>
        <a asp-page="/Maps/Browse" class="arcade-btn">BROWSE MAPS</a>
    </div>
</div>

<div class="share-lookup">
    <form method="get" asp-page="/Maps/Play" class="share-form">
        <label for="shareCode">ENTER SHARE CODE:</label>
        <input type="text" id="shareCode" name="code" maxlength="6"
               placeholder="ABC123" class="arcade-input" />
        <button type="submit" class="arcade-btn primary">LOAD</button>
    </form>
</div>

@if (Model.RecentMaps.Any())
{
    <section class="recent-maps">
        <h2 class="section-title">RECENT MAPS</h2>
        <div class="map-grid">
            @foreach (var map in Model.RecentMaps)
            {
                <a asp-page="/Maps/Play" asp-route-code="@map.ShareCode" class="map-card">
                    <div class="map-card-preview" data-width="@map.Width" data-height="@map.Height"
                         data-cells="@map.CellData"></div>
                    <div class="map-card-info">
                        <span class="map-name">@map.Name</span>
                        <span class="map-size">@(map.Width)x@(map.Height)</span>
                        <span class="map-code">@map.ShareCode</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
